# Harvester - testnet by default
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
# live trading needs its own keys (withdrawals disabled, IP-restricted):
BINANCE_LIVE_API_KEY=
BINANCE_LIVE_API_SECRET=
MAX_ORDER_NOTIONAL=5000
MAX_LEVERAGE=20
# optional: a free CryptoPanic key adds their per-coin news feed to the News panel
CRYPTOPANIC_API_KEY=

# optional: an Anthropic API key enables the AI Analyst panel (keep it here: this file is never committed)
ANTHROPIC_API_KEY=

# optional: a Telegram bot for a summary every 30 minutes and chart pictures on request (use a bot of its own: two programs cannot poll one bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# optional: scanner entries with this score or more are sent as alerts (default 85, 0 = none)
TELEGRAM_SIGNAL_MIN_SCORE=
# optional: off keeps this program from using the Telegram bot (when another Harvester program is the one that talks to it)
HARVESTER_TELEGRAM=
# optional: 1 = the headless server also processes held and armed orders (then do not run the desktop app at the same time)
HARVESTER_SERVER_ORDERS=

# optional web mode of harvester-server: the address to listen on (127.0.0.1:8787 = this computer only) and the password the page asks for (12+ characters)
HARVESTER_WEB_BIND=
HARVESTER_WEB_TOKEN=
